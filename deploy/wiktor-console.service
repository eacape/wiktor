# Wiktor Step12 — wiktor-console systemd unit（spec step12 §4 B3，D5）。
# 只读监督面，只绑 127.0.0.1:8081；远程访问走 SSH 隧道（README runbook），
# 不暴露公网。
# Wiktor Step12 — the wiktor-console systemd unit (spec step12 §4 B3, D5).
# A read-only supervisory surface bound to 127.0.0.1:8081 only; remote access
# goes through an SSH tunnel (README runbook), never exposed publicly.
[Unit]
Description=Wiktor Web console (read-only supervision)
After=network-online.target wiktor-server.service
Wants=network-online.target

[Service]
Type=simple
User=wiktor
Group=wiktor
# 与 wiktor-server.service 对齐（P6）：注入 /etc/wiktor/wiktor.env，使 console
# 的 `/api/search` 按 env 装配真实 qdrant 向量 + 真实嵌入（否则恒 mock 退化纯 FTS）。
# Aligned with wiktor-server.service (P6): inject /etc/wiktor/wiktor.env so the
# console `/api/search` assembles the real qdrant vectors + real embedder per env
# (otherwise it stays mock and degrades to FTS-only).
EnvironmentFile=/etc/wiktor/wiktor.env
ExecStart=/usr/local/bin/wiktor console --db /srv/wiktor/data/wiktor.db --listen 127.0.0.1:8081
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/wiktor/data

[Install]
WantedBy=multi-user.target
