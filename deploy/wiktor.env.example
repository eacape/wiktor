# Wiktor Step12 生产环境变量模板（spec step12 §4 B3）。
# Wiktor Step12 production environment template (spec step12 §4 B3).
#
# 部署：复制到 /etc/wiktor/wiktor.env 并填入真实值；权限必须 0640 root:wiktor
# （install-wiktor.sh 会保证）。监听地址在 systemd 单元 ExecStart 里固定为
# 127.0.0.1（公网暴露 = 改单元 + 防火墙放行，见 README runbook）。
# Deploy: copy to /etc/wiktor/wiktor.env and fill real values; the file must be
# 0640 root:wiktor (install-wiktor.sh enforces it). Listen addresses are fixed
# to 127.0.0.1 in the unit ExecStart lines (public exposure = edit the unit +
# open the firewall, see the README runbook).

# 方法级 API key：domain 键必须与 seed 的领域包域名一致；secret 换成强随机值。
# methods 只接受小写 snake_case（服务端允许集：
# search / compile / qug_build / review / compatibility / status / feedback）。
# Method-level API keys: the domain key must match the seeded domain-pack name;
# replace the secret with a strong random value. The methods set only accepts
# lowercase snake_case (the server's allowed set: search / compile / qug_build /
# review / compatibility / status / feedback).
WIKTOR_API_KEYS={"tech-docs":{"secret":"CHANGE-ME","methods":["search","compile","qug_build","review","compatibility","status","feedback"]}}

# 编译 worker 数（1..=8；2C/2G 机器建议 2）。
# Compile workers (1..=8; 2 recommended on a 2C/2G box).
WIKTOR_COMPILE_WORKERS=2

# P1 查询热点缓存容量（MASTER-PLAN §5.4/§5.5：generation-aware + 实体失效；
# 缓存命中集合而非整条 QueryResult——log_id 每次查询独立）。设 0 关闭。
# P1 query hot-cache capacity (MASTER-PLAN §5.4/§5.5: generation-aware + entity
# invalidation; caches the hit set, not the whole QueryResult — log_id is per-query).
# Set 0 to disable.
WIKTOR_QUERY_CACHE_SIZE=512

# —— Step0a：真实向量后端（qdrant）+ 查询嵌入（OpenAI 兼容 /embeddings）——
# —— Step0a: real vector backend (qdrant) + query embedding (OpenAI-compatible
#     /embeddings) ——
# mock（默认）| qdrant。qdrant 只在 Linux 上安装/测试（Mac 不装）。
# mock (default) | qdrant. qdrant is installed/tested only on Linux (never Mac).
# WIKTOR_VECTOR_BACKEND=qdrant
# WIKTOR_QDRANT_URL=http://127.0.0.1:6334
# WIKTOR_QDRANT_API_KEY=
#
# 缺省模型即 qwen3.7-text-embedding-flash（core embedding/default 一致）。
# The default model is already qwen3.7-text-embedding-flash (matches core).
# WIKTOR_EMBEDDING_BASE_URL=https://<host>/compatible-mode/v1
# WIKTOR_EMBEDDING_API_KEY=CHANGE-ME
# WIKTOR_EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# —— Step0b：serve 常驻编译 worker 的真实 LLM（OpenAI 兼容 /chat/completions）——
# —— Step0b: real LLM for the serve resident compile worker (OpenAI-compatible
#     /chat/completions) ——
# 设了 WIKTOR_LLM_BASE_URL 才启用；未设回退 MockCompiler（离线）。缺 key 报错，
# 绝不降级 Mock。WIKTOR_LLM_DISABLE_THINKING=1 对 qwen 网关强制关思考（否则
# content 恒空）。真实值只写 /etc/wiktor/wiktor.env，不进 git/文档。
# Real-LLM compile is enabled only when WIKTOR_LLM_BASE_URL is set; otherwise the
# worker falls back to MockCompiler (offline). A missing key is a hard error, never
# a silent Mock. WIKTOR_LLM_DISABLE_THINKING=1 forces thinking off on qwen
# gateways (otherwise content stays empty). Real values live only in
# /etc/wiktor/wiktor.env, never in git/docs.
# WIKTOR_LLM_BASE_URL=https://llm.goaichat.top/v1
# WIKTOR_LLM_MODEL=qwen3.8-max
# WIKTOR_OPENAI_API_KEY=CHANGE-ME
# WIKTOR_LLM_DISABLE_THINKING=1
